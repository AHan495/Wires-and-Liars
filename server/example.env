# Google OAuth
GOOGLE_CLIENT_ID=client_id_for_google_oauth
GOOGLE_CLIENT_SECRET=client_secret_for_google_oauth

# Token for AI Usage
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Stripe secrets
STRIPE_SECRET_KEY=your_secret_key
STRIPE_WEBHOOK_ENDPOINT_SECRET=your_endpoint_secret

# Session Secret
SESSION_SECRET=very_long_string_for_session

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wires_and_liars
DB_SSL=false

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Deployment
FRONTEND_URL=http://localhost:5173
BACKEND_URL=your_URL_goes_here
PORT=3000
